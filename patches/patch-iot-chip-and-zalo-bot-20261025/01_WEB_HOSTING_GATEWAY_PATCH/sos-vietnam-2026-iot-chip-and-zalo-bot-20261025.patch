+void updateSignalStrength() {
+  String res = sendATCommand("AT+CSQ", 1000, false);
+  int idx = res.indexOf("+CSQ:");
+  if (idx != -1) {
+    int commaIdx = res.indexOf(",", idx);
+    if (commaIdx != -1) {
+      String csqStr = res.substring(idx + 5, commaIdx);
+      csqStr.trim();
+      int val = csqStr.toInt();
+      if (val >= 0 && val <= 31) {
+        currentCsq = val;
+      }
+    }
+  }
