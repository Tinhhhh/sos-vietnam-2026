+// ============================================================================
+// Xß╗¼ L├¥ Gß╗¼I B├üO ─Éß╗ÿNG SAU KHI ─Éß╗ª 5 GI├éY X├üC NHß║¼N Sß╗É Lß║ªN NHß║ñN
+// ============================================================================
+
+void triggerConfirmedSOS(int confirmedCount) {
+  int step = confirmedCount;
+  if (step < 1) step = 1;
+  if (step > 3) step = 3;
+
+  const char* agencyCode   = "police";
+  const char* incidentType = "BAO_CONG_AN_DIA_PHUONG";
+  const char* stepLabel    = "NHß║ñN 1 Lß║ªN - B├üO C├öNG AN ─Éß╗èA PH╞»╞áNG";
+
+  if (step == 1) {
+    agencyCode   = "police";
+    incidentType = "BAO_CONG_AN_DIA_PHUONG";
+    stepLabel    = "NHß║ñN 1 Lß║ªN - B├üO C├öNG AN ─Éß╗èA PH╞»╞áNG";
+  } else if (step == 2) {
+    agencyCode   = "csgt";
+    incidentType = "BAO_CANH_SAT_GIAO_THONG";
+    stepLabel    = "NHß║ñN 2 Lß║ªN - B├üO Cß║óNH S├üT GIAO TH├öNG (CSGT)";
+  } else {
+    agencyCode   = "fire";
+    incidentType = "BAO_PCCC_VA_CNCH";
+    stepLabel    = "NHß║ñN 3 Lß║ªN - B├üO Cß║óNH S├üT PCCC V├Ç CNCH";
+  }
+
+  Serial.printf("\n>>> ─É├â Hß║╛T 5 GI├éY CHß╗£: X├üC NHß║¼N %d Lß║ªN NHß║ñN -> %s <<<\n", step, stepLabel);
+
+  // K├¬u c├▓i x├íc nhß║¡n sß╗æ lß║ºn nhß║Ñn (1 tiß║┐ng, 2 tiß║┐ng hoß║╖c 3 tiß║┐ng)
+  beepBuzzer(step, 200);
+
+  // ╞»u ti├¬n ph├ít qua SIM 4G LTE tr├¬n module Quectel EG800K
+  bool ok = sendSosVia4GModem(step, agencyCode, incidentType, stepLabel);
+  if (!ok) {
+    ok = sendSosViaBackupWifi(step, agencyCode, incidentType, stepLabel);
+  }
+
+  if (ok) {
+    // B├ío th├ánh c├┤ng: 2 tiß║┐ng b├¡p ngß║»n
+    beepBuzzer(2, 100);
+  } else {
+    Serial.println("[Cß║óNH B├üO] Ch╞░a gß╗¡i ─æ╞░ß╗úc l├¬n m├íy chß╗º. Vui l├▓ng kiß╗âm tra SIM 4G v├á Anten!");
+    beepBuzzer(4, 80);
+  }
+}
