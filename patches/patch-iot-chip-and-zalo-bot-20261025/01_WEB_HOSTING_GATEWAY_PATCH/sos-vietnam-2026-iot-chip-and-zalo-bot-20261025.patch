+bool sendSosVia4GModem(int step, const char* agencyCode, const char* incidentType, const char* stepLabel) {
+  Serial.println("\n=== ─ÉANG PH├üT T├ìN HIß╗åU SOS QUA Mß║áNG DI ─Éß╗ÿNG 4G LTE (SIM) ===");
+
+  // ─Éß╗ìc tß╗ìa ─æß╗Ö GPS mß╗¢i nhß║Ñt ngay tr╞░ß╗¢c khi ph├ít lß╗çnh SOS
