+// ============================================================================
+// SETUP & LOOP CH├ìNH
+// ============================================================================
+
+void setup() {
+  // 1. Khß╗ƒi tß║ío cß╗òng USB Serial (Nhß╗¢ bß║¡t Tools -> USB CDC On Boot -> Enabled)
+  Serial.begin(115200);
+  delay(2000);
+  Serial.println("\n=======================================================");
+  Serial.println("=== KHß╗₧I ─Éß╗ÿNG KIT 4G GPS ESP32-C3 TDM2421 (EG800K) ===");
+  Serial.println("=======================================================");
+
+  // 2. Cß║Ñu h├¼nh ch├ón n├║t bß║Ñm, c├▓i b├ío v├á LED trß║íng th├íi
+  pinMode(RF_BUTTON_PIN, INPUT_PULLUP);
+  pinMode(ONBOARD_BTN_PIN, INPUT_PULLUP);
+  pinMode(BUZZER_PIN, OUTPUT);
+  pinMode(LED_PIN, OUTPUT);
+
+  digitalWrite(BUZZER_PIN, LOW);
+  digitalWrite(LED_PIN, LOW);
+
+  // 3. Khß╗ƒi tß║ío UART1 giao tiß║┐p vß╗¢i module 4G Quectel EG800K (Baudrate 115200)
+  simSerial.begin(115200, SERIAL_8N1, SIM_RX_PIN, SIM_TX_PIN);
+
+  // 4. Bß║¡t nguß╗ôn module SIM 4G EG800K v├á k├¡ch hoß║ít GPS/GNSS
+  powerOnModule();
+  initModem4GAndGps();
+
+  Serial.println("\n=======================================================");
+  Serial.println("Hß╗å THß╗ÉNG ─É├â Sß║┤N S├ÇNG HOß║áT ─Éß╗ÿNG ─Éß╗ÿC Lß║¼P QUA 4G + GPS!");
+  Serial.println("- Nhß║Ñn 1 lß║ºn (chß╗¥ 5s): B├ío C├┤ng An ─Éß╗ïa Ph╞░╞íng");
+  Serial.println("- Nhß║Ñn 2 lß║ºn (chß╗¥ 5s): B├ío Cß║únh S├ít Giao Th├┤ng (CSGT)");
+  Serial.println("- Nhß║Ñn 3 lß║ºn (chß╗¥ 5s): B├ío Cß║únh S├ít PCCC & CNCH");
+  Serial.println("- Bß║ín c┼⌐ng c├│ thß╗â g├╡ lß╗çnh AT trß╗▒c tiß║┐p tr├¬n Serial Monitor");
+  Serial.println("=======================================================\n");
+}
+
+void loop() {
+  unsigned long now = millis();
+
+  // 1. PH├üT HIß╗åN NHß║ñN N├ÜT (CHß╗ÉNG Dß╗ÿI PH├ìM & ─Éß║╛M Sß╗É Lß║ªN NHß║ñN TRONG 5 GI├éY)
+  bool rawPressed = (digitalRead(RF_BUTTON_PIN) == LOW) || (digitalRead(ONBOARD_BTN_PIN) == LOW);
+
+  if (rawPressed != lastReading) {
+    lastDebounceTime = now;
+    lastReading = rawPressed;
+  }
+
+  if ((now - lastDebounceTime) >= DEBOUNCE_MS) {
+    if (rawPressed != stableButtonState) {
+      stableButtonState = rawPressed;
+
+      if (stableButtonState == true) {
+        pressCount++;
+        if (pressCount > 3) {
+          pressCount = 3;
+        }
+        lastPressTime = now;
+
+        // K├¬u 1 tiß║┐ng b├¡p ngß║»n mß╗ùi lß║ºn bß║Ñm ─æß╗â ng╞░ß╗¥i gi├á biß║┐t mß║ích ─æ├ú nhß║¡n thao t├íc
+        digitalWrite(LED_PIN, HIGH);
+        digitalWrite(BUZZER_PIN, HIGH);
+        delay(80);
+        digitalWrite(BUZZER_PIN, LOW);
+        digitalWrite(LED_PIN, LOW);
+
+        Serial.printf("─É├ú ghi nhß║¡n lß║ºn nhß║Ñn thß╗⌐ %d. ─Éang chß╗¥ ─æß╗º 5 gi├óy ─æß╗â x├íc nhß║¡n...\n", pressCount);
+      }
+    }
+  }
+
+  // 2. Nß║╛U ─É├â NHß║ñN V├Ç SAU 5 GI├éY KH├öNG NHß║ñN TIß║╛P -> CHß╗ÉT Lß╗åNH Gß╗¼I SOS QUA 4G + GPS
+  if (pressCount > 0 && !stableButtonState && (now - lastPressTime >= CONFIRM_WINDOW_MS)) {
+    int confirmed = pressCount;
+    pressCount = 0;
+    triggerConfirmedSOS(confirmed);
+  }
+
+  // 3. ─Éß╗èNH Kß╗▓ Mß╗ûI 10 GI├éY Cß║¼P NHß║¼T Tß╗îA ─Éß╗ÿ Vß╗å TINH GPS (KHI KH├öNG ─ÉANG Bß║ñM N├ÜT)
+  if (pressCount == 0 && (now - lastGpsCheck >= GPS_INTERVAL)) {
+    lastGpsCheck = now;
+    checkAndReadGps(true);
+  }
+
+  // 4. Cß║ªU Nß╗ÉI SERIAL MONITOR <-> MODULE 4G EG800K (CHO PH├ëP G├ò Lß╗åNH AT TRß╗░C TIß║╛P)
+  if (pressCount == 0 && Serial.available()) {
+    String line = Serial.readStringUntil('\n');
+    line.trim();
+    if (line.equalsIgnoreCase("TEST1")) {
+      triggerConfirmedSOS(1);
+    } else if (line.equalsIgnoreCase("TEST2")) {
+      triggerConfirmedSOS(2);
+    } else if (line.equalsIgnoreCase("TEST3")) {
+      triggerConfirmedSOS(3);
+    } else if (line.length() > 0) {
+      simSerial.println(line);
+    }
+  }
+
+  if (pressCount == 0 && simSerial.available()) {
+    while (simSerial.available()) {
+      Serial.write(simSerial.read());
+    }
+  }
+}
